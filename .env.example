# Copy to .env.local for local dev, or set these in your host's dashboard (Vercel).
# Leave DATABASE_URL unset locally to use a SQLite file at data/nutrition.db.

# Hosted database (Turso). Get these from `turso db show` and `turso db tokens create`.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-token-here

# Password gate. If unset, the app is open (fine for local dev).
# Set this in production so only you can access your data.
# APP_PASSWORD=choose-a-strong-password
